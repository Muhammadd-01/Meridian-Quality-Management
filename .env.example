# Public address of the deployed site (used for canonical URLs, social previews and sitemap.xml)
VITE_SITE_URL=https://your-domain.com

# Where the browser calls the Meridian API. Leave empty when the API is served
# from the same origin (or in development, where Vite proxies /api).
VITE_API_URL=

# Development only: where Vite forwards /api requests (default http://localhost:5080)
VITE_API_PROXY=http://localhost:5080
